<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng của tôi - PC Market</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <!-- HEADER -->
    <header>
        <div class="header-top">
            <div class="container">
                <div class="logo"><a href="/"><span class="logo-pc">PC</span><span class="logo-m">MDZ</span></a></div>
                <div class="search-bar">
                    <form action="/search">
                        <input type="text" name="q" placeholder="Tìm kiếm sản phẩm...">
                        <button><i class="fas fa-search"></i></button>
                    </form>
                </div>
                <div class="header-actions">
                    <% if (locals.isLoggedIn) { %>
                        <div class="user-dropdown">
                            <span class="user-name">
                                <i class="fas fa-user-circle"></i> <%= user.fullName %>
                                <% if (user.role === 'staff') { %>
                                    <span style="background:#e74c3c;color:white;padding:2px 8px;border-radius:10px;font-size:11px;margin-left:5px;">STAFF</span>
                                <% } %>
                                <% if (user.role === 'admin') { %>
                                    <span style="background:#007bff;color:white;padding:2px 8px;border-radius:10px;font-size:11px;margin-left:5px;">ADMIN</span>
                                <% } %>
                            </span>
                            <div class="dropdown-content">
                                <% if (user.role === 'admin') { %>
                                    <a href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Quản trị hệ thống</a>
                                <% } %>
                                <% if (user.role === 'staff') { %>
                                    <a href="/staff/dashboard" style="background:#fff5f5;color:#e74c3c !important;font-weight:600;">
                                        <i class="fas fa-user-tie"></i> Trang nhân viên
                                    </a>
                                <% } %>
                                <a href="/account"><i class="fas fa-id-card"></i> Tài khoản</a>
                                <a href="/orders"><i class="fas fa-shopping-bag"></i> Đơn hàng</a>
                                <a href="/cart"><i class="fas fa-shopping-cart"></i> Giỏ hàng</a>
                                <a href="/logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login">Đăng nhập</a>
                        <a href="/register">Đăng ký</a>
                    <% } %>
                    <a href="/cart" class="cart-icon"><i class="fas fa-shopping-cart"></i><span id="cart-count">0</span></a>
                </div>
            </div>
        </div>
        
        <!-- NAVIGATION MENU - ĐÃ SỬA (BỎ ICON, BỎ LAPTOP) -->
        <nav class="navigation-bar">
            <div class="container">
                <ul class="navigation-menu">
                    <li><a href="/"><i class="fas fa-home"></i> Trang chủ</a></li>
                    <li><a href="/products?category=pc-gaming-streaming"><i class="fas fa-gamepad"></i> PC GAMING, STREAMING</a></li>
                    <li><a href="/products?category=pc-workstation"><i class="fas fa-microchip"></i> PC WORKSTATION</a></li>
                    <li><a href="/products?category=pc-van-phong"><i class="fas fa-briefcase"></i> PC VĂN PHÒNG</a></li>
                    <li><a href="/products?category=laptop"><i class="fas fa-laptop"></i> LAPTOP</a></li>
                    <li><a href="/products?category=man-hinh-may-tinh"><i class="fas fa-desktop"></i> MÀN HÌNH MÁY TÍNH</a></li>
                    <li><a href="/products?category=linh-kien-may-tinh"><i class="fas fa-microchip"></i> LINH KIỆN MÁY TÍNH</a></li>
                </ul>
                <div class="hotline-number">
                    <i class="fas fa-phone-alt"></i> Hotline: 099.999.9999
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <main>
        <div class="container">
            <h1 class="page-title"><i class="fas fa-shopping-bag"></i> ĐƠN HÀNG CỦA TÔI</h1>
            
            <% if (orders && orders.length > 0) { %>
                <div class="orders-list">
                    <% for(var i = 0; i < orders.length; i++) { 
                        // SỬA: Chuyển từ tiếng Anh sang tiếng Việt
                        var statusClass = '';
                        var statusText = '';
                        var statusIcon = '';
                        
                        if (orders[i].orderStatus === 'Chờ xác nhận') { 
                            statusClass = 'status-pending'; 
                            statusText = 'Chờ xác nhận';
                            statusIcon = 'fa-clock';
                        } else if (orders[i].orderStatus === 'Đã xác nhận') { 
                            statusClass = 'status-confirmed'; 
                            statusText = 'Đã xác nhận';
                            statusIcon = 'fa-check-circle';
                        } else if (orders[i].orderStatus === 'Đang chuẩn bị') { 
                            statusClass = 'status-preparing'; 
                            statusText = 'Đang chuẩn bị';
                            statusIcon = 'fa-box';
                        } else if (orders[i].orderStatus === 'Đang giao hàng') { 
                            statusClass = 'status-shipping'; 
                            statusText = 'Đang giao hàng';
                            statusIcon = 'fa-truck';
                        } else if (orders[i].orderStatus === 'Đã giao hàng') { 
                            statusClass = 'status-delivered'; 
                            statusText = 'Đã giao hàng';
                            statusIcon = 'fa-check-double';
                        } else if (orders[i].orderStatus === 'Đã hủy') { 
                            statusClass = 'status-cancelled'; 
                            statusText = 'Đã hủy';
                            statusIcon = 'fa-ban';
                        } else {
                            statusClass = 'status-pending';
                            statusText = orders[i].orderStatus;
                            statusIcon = 'fa-question';
                        }
                    %>
                        <div class="order-card">
                            <div class="order-header">
                                <div class="order-info">
                                    <span class="order-code">Mã đơn: <strong><%= orders[i].orderCode %></strong></span>
                                    <span class="order-date"><i class="far fa-calendar-alt"></i> <%= new Date(orders[i].createdAt).toLocaleDateString('vi-VN') %></span>
                                </div>
                                <div class="order-status">
                                    <span class="status-badge <%= statusClass %>">
                                        <i class="fas <%= statusIcon %>"></i> <%= statusText %>
                                    </span>
                                </div>
                            </div>
                            <div class="order-body">
                                <div class="order-items-summary">
                                    <% for(var j = 0; j < Math.min(orders[i].items.length, 2); j++) { %>
                                        <div class="order-item-summary">
                                            <span class="item-name"><%= orders[i].items[j].productName %></span>
                                            <span class="item-quantity">x<%= orders[i].items[j].quantity %></span>
                                        </div>
                                    <% } %>
                                    <% if (orders[i].items.length > 2) { %>
                                        <div class="order-item-summary">... và <%= orders[i].items.length - 2 %> sản phẩm khác</div>
                                    <% } %>
                                </div>
                                <div class="order-total">
                                    <span>Tổng cộng:</span>
                                    <strong><%= orders[i].total.toLocaleString('vi-VN') %>đ</strong>
                                </div>
                            </div>
                            <div class="order-footer">
                                <a href="/orders/<%= orders[i]._id %>" class="btn btn-secondary"><i class="fas fa-eye"></i> Xem chi tiết</a>
                                <% if (orders[i].orderStatus === 'Chờ xác nhận') { %>
                                    <a href="/orders/<%= orders[i]._id %>/edit" class="btn btn-primary"><i class="fas fa-edit"></i> Sửa</a>
                                    <button class="btn btn-warning" onclick="cancelOrder('<%= orders[i]._id %>')"><i class="fas fa-times"></i> Hủy</button>
                                <% } %>
                                <% if (orders[i].orderStatus === 'Đã giao hàng' || orders[i].orderStatus === 'Đã hủy') { %>
                                    <button class="btn btn-danger" onclick="deleteOrder('<%= orders[i]._id %>')"><i class="fas fa-trash"></i> Xóa</button>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-shopping-bag fa-4x"></i>
                    <h2>Chưa có đơn hàng nào</h2>
                    <p>Hãy mua sắm ngay để trải nghiệm</p>
                    <a href="/products" class="btn btn-primary">Mua sắm ngay</a>
                </div>
            <% } %>
        </div>
    </main>

     <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-column">
                    <h4><i class="fas fa-store"></i> SHOWROOM - HÀ NỘI</h4>
                    <p>1A, Gốc Đề, Q.Hai Bà Trưng, Hà Nội</p>
                    <p>Tel: 034.567.8912</p>
                </div>
                <div class="footer-column">
                    <h4><i class="fas fa-store"></i> SHOWROOM - TP.HCM</h4>
                    <p>1A Cửu Long, P.15, Q.10, TP.HCM</p>
                    <p>Tel: 099.999.9999</p>
                </div>
                <div class="footer-column">
                    <h4><i class="fas fa-info-circle"></i> GIỚI THIỆU</h4>
                    <a href="#">Giới thiệu công ty</a>
                    <a href="#">Liên hệ</a>
                    <a href="#">Tin tức</a>
                </div>
                <div class="footer-column">
                    <h4><i class="fas fa-life-ring"></i> HỖ TRỢ</h4>
                    <a href="#">Hướng dẫn mua hàng</a>
                    <a href="#">Chính sách đổi trả</a>
                    <a href="#">Chính sách bảo hành</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© 2026 PC MDZ - Cửa hàng máy tính chuyên nghiệp</p>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
    <script>
        function cancelOrder(id) {
            if(confirm('Bạn có chắc muốn hủy đơn hàng này?')) {
                fetch('/orders/' + id + '/cancel', { method: 'POST' })
                .then(res => res.json())
                .then(data => { if(data.success) location.reload(); else alert(data.message); });
            }
        }
        function deleteOrder(id) {
            if(confirm('Bạn có chắc muốn xóa đơn hàng này?')) {
                fetch('/orders/' + id, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => { if(data.success) location.reload(); else alert(data.message); });
            }
        }
    </script>
</body>
</html>