<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PC MDZ Staff</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 25px; color: #ccc; text-decoration: none; transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        
        .page-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 20px; flex-wrap: wrap; gap: 15px;
        }
        .page-header h1 { font-size: 24px; color: #1a1a2e; }
        .search-box {
            display: flex; gap: 10px; background: white; padding: 5px 15px;
            border-radius: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .search-box input { border: none; padding: 10px; width: 250px; outline: none; font-size: 14px; }
        .search-box button { background: none; border: none; cursor: pointer; color: #e74c3c; font-size: 16px; }
        
        .notice-box {
            background: #e3f2fd; border-left: 4px solid #2196f3;
            padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;
            color: #1565c0; font-size: 14px;
        }
        .notice-box i { margin-right: 8px; }
        
        .filter-bar {
            display: flex; gap: 15px; margin-bottom: 20px;
            flex-wrap: wrap; align-items: center;
        }
        .filter-bar select {
            padding: 8px 15px; border: 1px solid #ddd;
            border-radius: 8px; font-size: 14px;
        }
        .filter-bar label { font-size: 14px; color: #555; font-weight: 500; }
        
        .stats-row {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 15px; margin-bottom: 20px;
        }
        .stat-mini {
            background: white; padding: 15px; border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            display: flex; align-items: center; gap: 12px;
        }
        .stat-mini-icon {
            width: 45px; height: 45px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .stat-mini-info h4 { font-size: 12px; color: #666; margin-bottom: 3px; font-weight: 500; }
        .stat-mini-info .value { font-size: 20px; font-weight: bold; color: #1a1a2e; }
        
        .product-table {
            width: 100%; background: white; border-radius: 12px;
            overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .product-table th, .product-table td {
            padding: 14px 12px; text-align: left; border-bottom: 1px solid #eee;
        }
        .product-table th {
            background: #f8f9fa; font-weight: 600;
            color: #555; font-size: 13px;
        }
        .product-table td { font-size: 13px; }
        .product-table tbody tr:hover { background: #fafafa; }
        
        .product-image {
            width: 50px; height: 50px; background: #f0f0f0;
            border-radius: 8px; display: flex;
            align-items: center; justify-content: center;
            overflow: hidden;
        }
        .product-image img { max-width: 100%; max-height: 100%; object-fit: contain; }
        .product-image i { color: #ccc; font-size: 20px; }
        
        .stock-badge {
            display: inline-block; padding: 4px 10px;
            border-radius: 20px; font-size: 12px;
            font-weight: 600; text-align: center;
        }
        .stock-high { background: #d4edda; color: #155724; }
        .stock-medium { background: #fff3cd; color: #856404; }
        .stock-low { background: #ffe5b4; color: #b25e00; }
        .stock-out { background: #f8d7da; color: #721c24; }
        
        .status-badge {
            padding: 4px 10px; border-radius: 20px;
            font-size: 11px; font-weight: 500;
        }
        .status-active { background: #d4edda; color: #155724; }
        .status-inactive { background: #f8d7da; color: #721c24; }
        
        .empty-row { text-align: center; padding: 50px; color: #999; }
        .empty-row i { font-size: 40px; margin-bottom: 10px; display: block; color: #ddd; }
        
        @media (max-width: 992px) {
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .product-table { display: block; overflow-x: auto; }
        }
        @media (max-width: 576px) {
            .stats-row { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <%- include('../partials/staff-sidebar', { currentPage: 'products' }) %>
        
        <div class="admin-main">
            <div class="page-header">
                <h1><i class="fas fa-box"></i> Xem sản phẩm & tồn kho</h1>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm sản phẩm...">
                    <button onclick="searchProducts()"><i class="fas fa-search"></i></button>
                </div>
            </div>
            
            <!-- Thông báo quyền hạn -->
            <div class="notice-box">
                <i class="fas fa-info-circle"></i>
                <strong>Chế độ chỉ xem:</strong> Nhân viên bán hàng chỉ có thể xem thông tin sản phẩm và tồn kho. 
                Để đề xuất nhập hàng, vui lòng sử dụng chức năng 
                <a href="/staff/stock-requests" style="color:#1565c0;font-weight:600;text-decoration:underline;">Đề xuất nhập hàng</a>.
            </div>
            
            <!-- Thống kê nhanh -->
            <div class="stats-row">
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#e3f2fd;color:#2196f3;">
                        <i class="fas fa-box"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Tổng sản phẩm</h4>
                        <div class="value"><%= products.length %></div>
                    </div>
                </div>
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#e8f5e9;color:#4caf50;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Còn hàng</h4>
                        <div class="value">
                            <%= products.filter(p => p.stock > 10).length %>
                        </div>
                    </div>
                </div>
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#fff3cd;color:#856404;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Sắp hết</h4>
                        <div class="value">
                            <%= products.filter(p => p.stock > 0 && p.stock <= 10).length %>
                        </div>
                    </div>
                </div>
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#f8d7da;color:#721c24;">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Hết hàng</h4>
                        <div class="value">
                            <%= products.filter(p => p.stock === 0).length %>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Bộ lọc -->
            <div class="filter-bar">
                <label><i class="fas fa-filter"></i> Lọc:</label>
                <select id="categoryFilter" onchange="filterProducts()">
                    <option value="">Tất cả danh mục</option>
                    <% categories.forEach(c => { %>
                        <option value="<%= c.name %>"><%= c.name %></option>
                    <% }) %>
                </select>
                <select id="stockFilter" onchange="filterProducts()">
                    <option value="">Tất cả tồn kho</option>
                    <option value="in">Còn hàng (> 10)</option>
                    <option value="low">Sắp hết (1-10)</option>
                    <option value="out">Hết hàng (0)</option>
                </select>
                <button onclick="resetFilters()" style="background:#6c757d;color:white;padding:8px 15px;border:none;border-radius:8px;cursor:pointer;font-size:13px;">
                    <i class="fas fa-times"></i> Xóa bộ lọc
                </button>
            </div>
            
            <!-- Bảng sản phẩm -->
            <div style="overflow-x: auto;">
                <table class="product-table" id="productsTable">
                    <thead>
                        <tr>
                            <th style="width:60px;">Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Cấu hình</th>
                            <th>Giá bán</th>
                            <th style="text-align:center;">Tồn kho</th>
                            <th style="text-align:center;">Đã bán</th>
                            <th style="text-align:center;">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody id="productsTableBody">
                        <% if (products && products.length > 0) { %>
                            <% products.forEach(p => { 
                                var stockClass = 'stock-high';
                                var stockText = p.stock;
                                if (p.stock === 0) { stockClass = 'stock-out'; stockText = '0'; }
                                else if (p.stock <= 10) { stockClass = 'stock-low'; }
                                else if (p.stock <= 50) { stockClass = 'stock-medium'; }
                            %>
                            <tr data-category="<%= p.categories && p.categories.length > 0 ? p.categories.map(c => c.name).join(', ') : '' %>"
                                data-stock="<%= p.stock %>">
                                <td>
                                    <div class="product-image">
                                        <% if (p.image) { %>
                                            <img src="<%= p.image %>" alt="<%= p.name %>">
                                        <% } else { %>
                                            <i class="fas fa-desktop"></i>
                                        <% } %>
                                    </div>
                                </td>
                                <td>
                                    <strong style="color:#1a1a2e;"><%= p.name %></strong>
                                </td>
                                <td>
                                    <% if (p.categories && p.categories.length > 0) { %>
                                        <% p.categories.forEach(c => { %>
                                            <span style="display:inline-block;background:#f0f0f0;color:#555;padding:2px 8px;border-radius:12px;font-size:11px;margin-right:4px;">
                                                <%= c.name %>
                                            </span>
                                        <% }) %>
                                    <% } else { %>
                                        <span style="color:#999;">Chưa phân loại</span>
                                    <% } %>
                                </td>
                                <td>
                                    <div style="font-size:12px;color:#666;line-height:1.5;">
                                        <% if (p.cpu) { %><div><i class="fas fa-microchip" style="color:#e74c3c;width:14px;"></i> <%= p.cpu %></div><% } %>
                                        <% if (p.ram) { %><div><i class="fas fa-memory" style="color:#e74c3c;width:14px;"></i> <%= p.ram %></div><% } %>
                                        <% if (p.storage) { %><div><i class="fas fa-hdd" style="color:#e74c3c;width:14px;"></i> <%= p.storage %></div><% } %>
                                        <% if (p.graphics) { %><div><i class="fas fa-tv" style="color:#e74c3c;width:14px;"></i> <%= p.graphics %></div><% } %>
                                        <% if (!p.cpu && !p.ram && !p.storage && !p.graphics) { %>
                                            <span style="color:#999;">Chưa có thông số</span>
                                        <% } %>
                                    </div>
                                </td>
                                <td style="color:#e74c3c;font-weight:600;">
                                    <%= p.price.toLocaleString('vi-VN') %>đ
                                </td>
                                <td style="text-align:center;">
                                    <span class="stock-badge <%= stockClass %>"><%= stockText %></span>
                                </td>
                                <td style="text-align:center;font-weight:500;">
                                    <%= p.soldCount || 0 %>
                                </td>
                                <td style="text-align:center;">
                                    <span class="status-badge <%= p.isActive ? 'status-active' : 'status-inactive' %>">
                                        <%= p.isActive ? 'Đang bán' : 'Ngừng bán' %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="empty-row">
                                    <i class="fas fa-box-open"></i>
                                    Chưa có sản phẩm nào trong hệ thống
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <script>
        function searchProducts() {
            const searchText = document.getElementById('searchInput').value.toLowerCase().trim();
            const rows = document.querySelectorAll('#productsTableBody tr');
            let hasResults = false;
            
            rows.forEach(row => {
                if (row.querySelector('.empty-row')) return;
                const text = row.innerText.toLowerCase();
                if (text.includes(searchText)) {
                    row.style.display = '';
                    hasResults = true;
                } else {
                    row.style.display = 'none';
                }
            });
            
            const noResultRow = document.getElementById('noResultRow');
            if (noResultRow) noResultRow.remove();
            
            if (!hasResults && searchText !== '') {
                const tbody = document.getElementById('productsTableBody');
                const newRow = document.createElement('tr');
                newRow.id = 'noResultRow';
                newRow.innerHTML = '<td colspan="8" class="empty-row"><i class="fas fa-search"></i>Không tìm thấy sản phẩm nào</td>';
                tbody.appendChild(newRow);
            }
        }
        
        function filterProducts() {
            const category = document.getElementById('categoryFilter').value;
            const stock = document.getElementById('stockFilter').value;
            const rows = document.querySelectorAll('#productsTableBody tr');
            let hasResults = false;
            
            rows.forEach(row => {
                if (row.querySelector('.empty-row')) return;
                
                const rowCategory = row.dataset.category || '';
                const rowStock = parseInt(row.dataset.stock) || 0;
                
                let show = true;
                if (category && !rowCategory.includes(category)) show = false;
                if (stock === 'out' && rowStock !== 0) show = false;
                if (stock === 'low' && (rowStock === 0 || rowStock > 10)) show = false;
                if (stock === 'in' && rowStock <= 10) show = false;
                
                row.style.display = show ? '' : 'none';
                if (show) hasResults = true;
            });
            
            const noResultRow = document.getElementById('noResultRow');
            if (noResultRow) noResultRow.remove();
            
            if (!hasResults) {
                const tbody = document.getElementById('productsTableBody');
                const newRow = document.createElement('tr');
                newRow.id = 'noResultRow';
                newRow.innerHTML = '<td colspan="8" class="empty-row"><i class="fas fa-filter"></i>Không có sản phẩm nào phù hợp với bộ lọc</td>';
                tbody.appendChild(newRow);
            }
        }
        
        function resetFilters() {
            document.getElementById('categoryFilter').value = '';
            document.getElementById('stockFilter').value = '';
            document.getElementById('searchInput').value = '';
            const rows = document.querySelectorAll('#productsTableBody tr');
            rows.forEach(row => {
                if (!row.querySelector('.empty-row')) row.style.display = '';
            });
            const noResultRow = document.getElementById('noResultRow');
            if (noResultRow) noResultRow.remove();
        }
        
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') searchProducts();
        });
    </script>
</body>
</html>