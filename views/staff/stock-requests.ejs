<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PC MDZ Staff</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 25px; color: #ccc; text-decoration: none; transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        
        .admin-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 25px; flex-wrap: wrap; gap: 15px;
        }
        .admin-header h1 { font-size: 24px; color: #1a1a2e; }
        
        .notice-box {
            background: #e3f2fd; border-left: 4px solid #2196f3;
            padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;
            color: #1565c0; font-size: 14px;
        }
        .notice-box i { margin-right: 8px; }
        
        .form-card {
            background: white; border-radius: 16px; padding: 25px;
            margin-bottom: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .form-card h3 {
            margin-bottom: 20px; padding-bottom: 12px;
            border-bottom: 2px solid #e74c3c;
            font-size: 16px; color: #333;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 2fr 1fr 2fr auto;
            gap: 15px; align-items: end;
        }
        .form-group { margin-bottom: 0; }
        .form-group label {
            display: block; margin-bottom: 8px;
            font-weight: 600; font-size: 13px; color: #333;
        }
        .form-group select, .form-group input {
            width: 100%; padding: 10px 12px;
            border: 1px solid #ddd; border-radius: 8px;
            font-size: 14px;
        }
        .form-group select:focus, .form-group input:focus {
            outline: none; border-color: #e74c3c;
            box-shadow: 0 0 0 3px rgba(231,76,60,0.1);
        }
        
        .btn-primary {
            background: #e74c3c; color: white; padding: 10px 20px;
            border: none; border-radius: 8px; cursor: pointer;
            font-weight: 600; font-size: 14px;
            display: inline-flex; align-items: center; gap: 6px;
            transition: all 0.3s;
        }
        .btn-primary:hover { background: #c0392b; }
        
        .stats-row {
            display: grid; grid-template-columns: repeat(4, 1fr);
            gap: 15px; margin-bottom: 20px;
        }
        .stat-mini {
            background: white; padding: 15px; border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            display: flex; align-items: center; gap: 12px;
        }
        .stat-mini-icon {
            width: 45px; height: 45px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
        }
        .stat-mini-info h4 { font-size: 12px; color: #666; margin-bottom: 3px; font-weight: 500; }
        .stat-mini-info .value { font-size: 20px; font-weight: bold; color: #1a1a2e; }
        
        .requests-table {
            width: 100%; background: white; border-radius: 12px;
            overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .requests-table th, .requests-table td {
            padding: 14px 12px; text-align: left; border-bottom: 1px solid #eee;
        }
        .requests-table th {
            background: #f8f9fa; font-weight: 600;
            color: #555; font-size: 13px;
        }
        .requests-table td { font-size: 13px; }
        .requests-table tbody tr:hover { background: #fafafa; }
        
        .status-badge {
            padding: 5px 12px; border-radius: 20px;
            font-size: 11px; font-weight: 600;
            display: inline-block;
        }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-approved { background: #cce5ff; color: #004085; }
        .status-rejected { background: #f8d7da; color: #721c24; }
        .status-imported { background: #d4edda; color: #155724; }
        
        .empty-row { text-align: center; padding: 50px; color: #999; }
        .empty-row i { font-size: 40px; margin-bottom: 10px; display: block; color: #ddd; }
        
        @media (max-width: 992px) {
            .form-row { grid-template-columns: 1fr; }
            .stats-row { grid-template-columns: repeat(2, 1fr); }
            .requests-table { display: block; overflow-x: auto; }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <%- include('../partials/staff-sidebar', { currentPage: 'stock-requests' }) %>
        
        <div class="admin-main">
            <div class="admin-header">
                <h1><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</h1>
            </div>
            
            <div class="notice-box">
                <i class="fas fa-info-circle"></i>
                <strong>Lưu ý:</strong> Đề xuất của bạn sẽ được gửi đến admin để duyệt. 
                Khi được duyệt và nhập hàng, tồn kho sẽ tự động cập nhật.
            </div>
            
            <!-- Thống kê nhanh -->
            <div class="stats-row">
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#e3f2fd;color:#2196f3;">
                        <i class="fas fa-list"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Tổng đề xuất</h4>
                        <div class="value"><%= requests.length %></div>
                    </div>
                </div>
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#fff3cd;color:#856404;">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Chờ duyệt</h4>
                        <div class="value">
                            <%= requests.filter(r => r.status === 'Chờ duyệt').length %>
                        </div>
                    </div>
                </div>
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#cce5ff;color:#004085;">
                        <i class="fas fa-check"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Đã duyệt</h4>
                        <div class="value">
                            <%= requests.filter(r => r.status === 'Đã duyệt' || r.status === 'Đã nhập hàng').length %>
                        </div>
                    </div>
                </div>
                <div class="stat-mini">
                    <div class="stat-mini-icon" style="background:#f8d7da;color:#721c24;">
                        <i class="fas fa-times"></i>
                    </div>
                    <div class="stat-mini-info">
                        <h4>Từ chối</h4>
                        <div class="value">
                            <%= requests.filter(r => r.status === 'Từ chối').length %>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Form tạo đề xuất -->
            <div class="form-card">
                <h3><i class="fas fa-plus-circle"></i> Tạo đề xuất mới</h3>
                <form method="POST" action="/staff/stock-requests">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Sản phẩm cần nhập <span style="color:#e74c3c;">*</span></label>
                            <select name="productId" required>
                                <option value="">-- Chọn sản phẩm --</option>
                                <% products.forEach(p => { %>
                                    <option value="<%= p._id %>">
                                        <%= p.name %> (Tồn: <%= p.stock %>)
                                    </option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Số lượng <span style="color:#e74c3c;">*</span></label>
                            <input type="number" name="requestedQuantity" min="1" placeholder="VD: 50" required>
                        </div>
                        <div class="form-group">
                            <label>Lý do</label>
                            <input type="text" name="reason" placeholder="VD: Sắp hết hàng">
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn-primary">
                                <i class="fas fa-paper-plane"></i> Gửi
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            
            <!-- Danh sách đề xuất -->
            <div class="form-card">
                <h3><i class="fas fa-list"></i> Danh sách đề xuất của tôi</h3>
                <div style="overflow-x: auto;">
                    <table class="requests-table">
                        <thead>
                            <tr>
                                <th style="width:50px;text-align:center;">STT</th>
                                <th>Sản phẩm</th>
                                <th style="text-align:center;">Tồn lúc tạo</th>
                                <th style="text-align:center;">SL đề xuất</th>
                                <th>Lý do</th>
                                <th style="text-align:center;">Trạng thái</th>
                                <th style="text-align:center;">Ngày tạo</th>
                                <th>Phản hồi từ admin</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (requests && requests.length > 0) { %>
                                <% requests.forEach((r, i) => { 
                                    var statusClass = '';
                                    if (r.status === 'Chờ duyệt') statusClass = 'status-pending';
                                    else if (r.status === 'Đã duyệt') statusClass = 'status-approved';
                                    else if (r.status === 'Từ chối') statusClass = 'status-rejected';
                                    else statusClass = 'status-imported';
                                %>
                                <tr>
                                    <td style="text-align:center;color:#666;"><%= i + 1 %></td>
                                    <td>
                                        <strong><%= r.product ? r.product.name : 'Sản phẩm đã xóa' %></strong>
                                    </td>
                                    <td style="text-align:center;color:#666;">
                                        <%= r.currentStock || 0 %>
                                    </td>
                                    <td style="text-align:center;color:#e74c3c;font-weight:700;">
                                        +<%= r.requestedQuantity %>
                                    </td>
                                    <td><%= r.reason || '-' %></td>
                                    <td style="text-align:center;">
                                        <span class="status-badge <%= statusClass %>">
                                            <%= r.status %>
                                        </span>
                                    </td>
                                    <td style="text-align:center;color:#666;font-size:12px;">
                                        <%= new Date(r.createdAt).toLocaleDateString('vi-VN') %>
                                    </td>
                                    <td style="font-size:12px;color:#666;">
                                        <%= r.reviewNote || '-' %>
                                        <% if (r.reviewedBy) { %>
                                            <br><i>— <%= r.reviewedBy.fullName %></i>
                                        <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="empty-row">
                                        <i class="fas fa-inbox"></i>
                                        Chưa có đề xuất nào
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>