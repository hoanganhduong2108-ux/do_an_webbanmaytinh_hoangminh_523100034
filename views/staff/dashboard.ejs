<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PC MDZ Staff</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 25px; color: #ccc; text-decoration: none; transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
        .admin-header h1 { font-size: 24px; color: #1a1a2e; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card {
            background: white; border-radius: 16px; padding: 20px;
            display: flex; align-items: center; justify-content: space-between;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .stat-info h4 { font-size: 13px; color: #666; margin-bottom: 8px; }
        .stat-number { font-size: 26px; font-weight: bold; color: #1a1a2e; }
        .stat-icon {
            width: 55px; height: 55px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; font-size: 24px;
        }
        .stat-card:nth-child(1) .stat-icon { background: #e3f2fd; color: #2196f3; }
        .stat-card:nth-child(2) .stat-icon { background: #e8f5e9; color: #4caf50; }
        .stat-card:nth-child(3) .stat-icon { background: #fff3e0; color: #ff9800; }
        .stat-card:nth-child(4) .stat-icon { background: #fce4ec; color: #e91e63; }
        .recent-orders-section {
            background: white; border-radius: 16px; padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .section-header h2 { font-size: 18px; color: #333; }
        .btn-view-all { color: #e74c3c; text-decoration: none; font-size: 13px; }
        .orders-table { width: 100%; border-collapse: collapse; }
        .orders-table th, .orders-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .orders-table th { background: #f8f9fa; font-weight: 600; color: #555; font-size: 13px; }
        .status-badge { padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 500; }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-confirmed { background: #cce5ff; color: #004085; }
        .status-preparing { background: #d4edda; color: #155724; }
        .status-shipping { background: #d1ecf1; color: #0c5460; }
        .status-delivered { background: #d4edda; color: #155724; }
        .status-cancelled { background: #f8d7da; color: #721c24; }
        .price-cell { color: #e74c3c; font-weight: 500; }
        .btn-sm { padding: 5px 12px; border-radius: 6px; font-size: 12px; text-decoration: none; background: #e74c3c; color: white; }
        .empty-row { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="admin-container">
        <%- include('../partials/staff-sidebar', { currentPage: 'dashboard' }) %>
        
        <div class="admin-main">
            <div class="admin-header">
                <h1><i class="fas fa-tachometer-alt"></i> Bảng điều khiển nhân viên</h1>
            </div>
            
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Đơn tôi đã xử lý</h4>
                        <div class="stat-number"><%= myProcessedOrders %></div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Đơn tôi tạo hộ</h4>
                        <div class="stat-number"><%= myCreatedOrders %></div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-plus-circle"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Đơn chờ xác nhận</h4>
                        <div class="stat-number" style="color:#ffc107"><%= pendingOrders %></div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-clock"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Doanh thu cá nhân</h4>
                        <div class="stat-number" style="color:#e74c3c;font-size:20px;">
                            <%= personalRevenue.toLocaleString('vi-VN') %>đ
                        </div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
                </div>
            </div>
            
            <div class="recent-orders-section">
                <div class="section-header">
                    <h2><i class="fas fa-clock"></i> Đơn hàng cần xử lý</h2>
                    <a href="/staff/orders" class="btn-view-all">Xem tất cả <i class="fas fa-arrow-right"></i></a>
                </div>
                <div style="overflow-x: auto;">
                    <table class="orders-table">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Số điện thoại</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày đặt</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentOrders && recentOrders.length > 0) { %>
                                <% recentOrders.forEach(o => { 
                                    var statusClass = '';
                                    if (o.orderStatus === 'Chờ xác nhận') statusClass = 'status-pending';
                                    else if (o.orderStatus === 'Đã xác nhận') statusClass = 'status-confirmed';
                                    else if (o.orderStatus === 'Đang chuẩn bị') statusClass = 'status-preparing';
                                    else if (o.orderStatus === 'Đang giao hàng') statusClass = 'status-shipping';
                                    else if (o.orderStatus === 'Đã giao hàng') statusClass = 'status-delivered';
                                    else statusClass = 'status-cancelled';
                                %>
                                <tr>
                                    <td><strong><%= o.orderCode %></strong></td>
                                    <td><%= o.fullName %></td>
                                    <td><%= o.phone %></td>
                                    <td class="price-cell"><%= o.total.toLocaleString('vi-VN') %>đ</td>
                                    <td><span class="status-badge <%= statusClass %>"><%= o.orderStatus %></span></td>
                                    <td><%= new Date(o.createdAt).toLocaleDateString('vi-VN') %></td>
                                    <td><a href="/staff/orders/<%= o._id %>" class="btn-sm">Xử lý</a></td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="7" class="empty-row">Chưa có đơn hàng nào cần xử lý</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>