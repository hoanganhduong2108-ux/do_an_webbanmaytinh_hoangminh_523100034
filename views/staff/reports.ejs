<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PC MDZ Staff</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 25px; color: #ccc; text-decoration: none; transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }

        .page-header {
            display: flex; justify-content: space-between; align-items: center;
            margin-bottom: 20px; flex-wrap: wrap; gap: 15px;
        }
        .page-header h1 { font-size: 24px; color: #1a1a2e; }

        .notice-box {
            background: #e3f2fd; border-left: 4px solid #2196f3;
            padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;
            color: #1565c0; font-size: 14px;
        }
        .notice-box i { margin-right: 8px; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .stat-icon {
            width: 55px; height: 55px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 24px;
        }
        .stat-info h3 { font-size: 13px; color: #666; margin-bottom: 5px; font-weight: 500; }
        .stat-number { font-size: 24px; font-weight: bold; color: #1a1a2e; }

        .chart-card {
            background: white; border-radius: 16px; padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05); margin-bottom: 20px;
        }
        .chart-card h3 {
            margin-bottom: 20px; font-size: 16px; color: #333;
            padding-bottom: 12px; border-bottom: 2px solid #e74c3c;
        }
        .chart-container { position: relative; height: 350px; }

        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th, .data-table td {
            padding: 12px; text-align: left; border-bottom: 1px solid #eee;
        }
        .data-table th { background: #f8f9fa; font-weight: 600; font-size: 13px; }
        .data-table td { font-size: 13px; }
        .price-cell { color: #e74c3c; font-weight: 600; }
        .empty-row { text-align: center; padding: 40px; color: #999; }

        @media (max-width: 992px) {
            .stats-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <%- include('../partials/staff-sidebar', { currentPage: 'reports' }) %>

        <div class="admin-main">
            <div class="page-header">
                <h1><i class="fas fa-chart-bar"></i> Báo cáo cá nhân</h1>
            </div>

            <div class="notice-box">
                <i class="fas fa-info-circle"></i>
                <strong>Báo cáo cá nhân:</strong> Chỉ hiển thị số liệu của riêng bạn.
                Để xem báo cáo toàn hệ thống, vui lòng liên hệ admin.
            </div>

            <!-- Thống kê tổng quan -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon" style="background:#e3f2fd;color:#2196f3;">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Tổng đơn đã xử lý</h3>
                        <div class="stat-number"><%= totalProcessed %></div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#e8f5e9;color:#4caf50;">
                        <i class="fas fa-plus-circle"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Tổng đơn tạo hộ</h3>
                        <div class="stat-number"><%= totalCreated %></div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon" style="background:#fce4ec;color:#e91e63;">
                        <i class="fas fa-dollar-sign"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Tổng doanh thu</h3>
                        <div class="stat-number" style="font-size:18px;">
                            <%= totalRevenue.toLocaleString('vi-VN') %>đ
                        </div>
                    </div>
                </div>
            </div>

            <!-- Biểu đồ doanh thu -->
            <div class="chart-card">
                <h3><i class="fas fa-chart-line"></i> Biểu đồ doanh thu theo tháng</h3>
                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>

            <!-- Bảng chi tiết doanh thu -->
            <div class="chart-card">
                <h3><i class="fas fa-table"></i> Chi tiết doanh thu theo tháng</h3>
                <div style="overflow-x: auto;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Tháng</th>
                                <th>Số đơn hàng</th>
                                <th>Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (monthlyRevenue && monthlyRevenue.length > 0) { %>
                                <% monthlyRevenue.forEach(function(item) { %>
                                <tr>
                                    <td><strong><%= item._id %></strong></td>
                                    <td><%= item.count %></td>
                                    <td class="price-cell"><%= item.revenue.toLocaleString('vi-VN') %>đ</td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="3" class="empty-row">
                                        <i class="fas fa-chart-line" style="font-size:30px;color:#ddd;display:block;margin-bottom:10px;"></i>
                                        Chưa có dữ liệu doanh thu
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== DATA ĐƯỢC NHÚNG Ở ĐÂY, KHÔNG TRONG THẺ SCRIPT ===== -->
    <div id="chartData"
         data-labels="<%= monthlyRevenue && monthlyRevenue.length > 0 ? monthlyRevenue.map(function(i){return i._id}).join('|') : '' %>"
         data-revenues="<%= monthlyRevenue && monthlyRevenue.length > 0 ? monthlyRevenue.map(function(i){return i.revenue}).join('|') : '' %>"
         style="display:none;">
    </div>

    <script>
        // Đọc data từ DOM (không có EJS trong script)
        var chartDataEl = document.getElementById('chartData');
        var labelsStr = chartDataEl.getAttribute('data-labels');
        var revenuesStr = chartDataEl.getAttribute('data-revenues');

        var labels = labelsStr ? labelsStr.split('|') : [];
        var revenues = revenuesStr ? revenuesStr.split('|').map(Number) : [];

        var chartLabels = labels.length > 0 ? labels : ['Chưa có dữ liệu'];
        var chartRevenues = revenues.length > 0 ? revenues : [0];

        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Doanh thu (đ)',
                    data: chartRevenues,
                    backgroundColor: '#e74c3c',
                    borderRadius: 8,
                    borderSkipped: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Doanh thu: ' + context.parsed.y.toLocaleString('vi-VN') + 'đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + 'đ';
                            }
                        }
                    }
                }
            }
        });
    </script>
</body>
</html>