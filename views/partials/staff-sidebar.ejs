        <p style="font-size:11px;color:#4fc3f7;">Mã NV: <%= user.staffCode || 'N/A' %></p>
    </div>
    <a href="/staff/dashboard" class="sidebar-link <%= currentPage === 'dashboard' ? 'active' : '' %>">
