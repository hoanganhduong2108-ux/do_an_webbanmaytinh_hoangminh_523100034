    </div>
</aside>
                
                <!-- PRODUCTS MAIN -->
                <div class="products-main">
                    <div class="products-header">
                        <h2>Tìm thấy <span class="product-count"><%= products ? products.length : 0 %></span> sản phẩm</h2>
                        <div class="sort-options">
                            <label><i class="fas fa-sort"></i> Sắp xếp theo:</label>
                            <select id="sortSelect" onchange="applySorting()">
                                <option value="newest" <%= query && (query.sort === 'newest' || !query.sort) ? 'selected' : '' %>>Mới nhất</option>
                                <option value="price_asc" <%= query && query.sort === 'price_asc' ? 'selected' : '' %>>Giá tăng dần</option>
                                <option value="price_desc" <%= query && query.sort === 'price_desc' ? 'selected' : '' %>>Giá giảm dần</option>
                                <option value="sold" <%= query && query.sort === 'sold' ? 'selected' : '' %>>Bán chạy nhất</option>
                            </select>
                        </div>
                    </div>
                    
                    <% if (products && products.length > 0) { %>
                        <div class="products-grid">
                            <% for(var i = 0; i < products.length; i++) { %>
                                <div class="product-card">
                                    <div class="product-image">
                                        <a href="/product/<%= products[i].slug %>">
                                            <% if (products[i].image) { %>
                                                <img src="<%= products[i].image %>" alt="<%= products[i].name %>">
                                            <% } else { %>
                                                <div class="no-image"><i class="fas fa-desktop fa-3x"></i></div>
                                            <% } %>
                                        </a>
                                        <% if (products[i].oldPrice) { %>
                                            <span class="discount-badge">-<%= Math.round((1 - products[i].price / products[i].oldPrice) * 100) %>%</span>
                                        <% } %>
                                    </div>
                                    <div class="product-info">
                                        <h3 class="product-name"><a href="/product/<%= products[i].slug %>"><%= products[i].name %></a></h3>
                                        <div class="product-categories">
                                            <i class="fas fa-folder"></i>
                                            <% if (products[i].categories && products[i].categories.length > 0) { %>
                                                <%= products[i].categories.map(c => c.name).join(', ') %>
                                            <% } else { %>
                                                Chưa phân loại
                                            <% } %>
                                        </div>
                                        <div class="product-price">
                                            <span class="current-price"><%= products[i].price.toLocaleString('vi-VN') %>đ</span>
                                            <% if (products[i].oldPrice) { %>
                                                <span class="old-price"><%= products[i].oldPrice.toLocaleString('vi-VN') %>đ</span>
                                            <% } %>
                                        </div>
                                        <div class="product-actions">
                                            <% if (locals.isLoggedIn) { %>
                                                <button class="add-to-cart-btn" onclick="addToCart('<%= products[i]._id %>')">
                                                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                                                </button>
                                            <% } else { %>
                                                <button class="add-to-cart-btn" onclick="alert('Vui lòng đăng nhập để mua hàng')">
                                                    <i class="fas fa-shopping-cart"></i> Đăng nhập để mua
                                                </button>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <% } else { %>
                        <div class="no-products">
                            <i class="fas fa-search fa-4x"></i>
                            <h3>Không tìm thấy sản phẩm nào</h3>
                            <p>Vui lòng thử lại với từ khóa khác hoặc xóa bộ lọc</p>
                            <button class="btn btn-primary" onclick="clearFilters()">Xóa bộ lọc</button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer>
