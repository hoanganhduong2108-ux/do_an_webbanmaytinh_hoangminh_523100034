                    <h4><i class="fas fa-dollar-sign"></i> Khoảng giá</h4>
                    <div class="price-range">
                        <div class="price-input-group">
                            <input type="number" name="minPrice" placeholder="Từ" value="<%= query && query.minPrice ? query.minPrice : '' %>" class="price-input">
                        </div>
                        <span class="price-separator">-</span>
                        <div class="price-input-group">
                            <input type="number" name="maxPrice" placeholder="Đến" value="<%= query && query.maxPrice ? query.maxPrice : '' %>" class="price-input">
