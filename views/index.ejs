<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PC Market - Website bán máy tính chuyên nghiệp</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>
<body>
    <!-- HEADER TOP -->
    <header>
        <div class="header-top">
            <div class="container">
                <div class="logo">
                    <a href="/">
                        <span class="logo-pc">PC</span>
                        <span class="logo-m">MDZ</span>
                    </a>
                </div>
                <div class="search-bar">
                    <form action="/search" method="GET">
                        <input type="text" name="q" placeholder="Tìm kiếm sản phẩm máy tính, linh kiện..." required>
                        <button type="submit"><i class="fas fa-search"></i></button>
                    </form>
                </div>
                <div class="header-actions">
                    <% if (locals.isLoggedIn) { %>
                        <div class="user-dropdown">
                            <span class="user-name">
                                <i class="fas fa-user-circle"></i> <%= user.fullName %>
                                <% if (user.role === 'staff') { %>
                                    <span style="background:#e74c3c;color:white;padding:2px 8px;border-radius:10px;font-size:11px;margin-left:5px;">STAFF</span>
                                <% } %>
                                <% if (user.role === 'admin') { %>
                                    <span style="background:#007bff;color:white;padding:2px 8px;border-radius:10px;font-size:11px;margin-left:5px;">ADMIN</span>
                                <% } %>
                            </span>
                            <div class="dropdown-content">
                                <% if (user.role === 'admin') { %>
                                    <a href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Quản trị hệ thống</a>
                                <% } %>
                                <% if (user.role === 'staff') { %>
                                    <a href="/staff/dashboard" style="background:#fff5f5;color:#e74c3c !important;font-weight:600;">
                                        <i class="fas fa-user-tie"></i> Trang nhân viên
                                    </a>
                                <% } %>
                                <a href="/account"><i class="fas fa-id-card"></i> Tài khoản</a>
                                <a href="/orders"><i class="fas fa-shopping-bag"></i> Đơn hàng</a>
                                <a href="/cart"><i class="fas fa-shopping-cart"></i> Giỏ hàng</a>
                                <a href="/logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
                            </div>
                        </div>
                    <% } else { %>
                        <a href="/login"><i class="fas fa-sign-in-alt"></i> Đăng nhập</a>
                        <a href="/register"><i class="fas fa-user-plus"></i> Đăng ký</a>
                    <% } %>
                    <a href="/cart" class="cart-icon">
                        <i class="fas fa-shopping-cart"></i>
                        <span id="cart-count">0</span>
                    </a>
                </div>
            </div>
        </div>
        
        <!-- NAVIGATION MENU -->
        <nav class="navigation-bar">
            <div class="container">
                <ul class="navigation-menu">
                    <li><a href="/"><i class="fas fa-home"></i> Trang chủ</a></li>
                    <li><a href="/products?category=pc-gaming-streaming"><i class="fas fa-gamepad"></i> PC GAMING, STREAMING</a></li>
                    <li><a href="/products?category=pc-workstation"><i class="fas fa-microchip"></i> PC WORKSTATION</a></li>
                    <li><a href="/products?category=pc-van-phong"><i class="fas fa-briefcase"></i> PC VĂN PHÒNG</a></li>
                    <li><a href="/products?category=laptop"><i class="fas fa-laptop"></i> LAPTOP</a></li>
                    <li><a href="/products?category=man-hinh-may-tinh"><i class="fas fa-desktop"></i> MÀN HÌNH MÁY TÍNH</a></li>
                    <li><a href="/products?category=linh-kien-may-tinh"><i class="fas fa-microchip"></i> LINH KIỆN MÁY TÍNH</a></li>
                </ul>
                <div class="hotline-number">
                    <i class="fas fa-phone-alt"></i> Hotline: 099.999.9999
                </div>
            </div>
        </nav>
    </header>

    <!-- BANNER HERO -->
    <section class="hero-banner">
        <div class="container">
            <div class="banner-content">
                <h1>BUILD - PC GAMING</h1>
                <p>RINH DEAL ĐÌNH - CHIẾN GAME HAY</p>
                <div class="banner-buttons">
                    <a href="/products" class="btn btn-primary btn-large">Xem ngay</a>
                    <a href="/products?sort=sold" class="btn btn-outline btn-large">Sản phẩm bán chạy</a>
                </div>
            </div>
        </div>
    </section>

    <div class="container">
        <section class="product-section">
            <div class="section-header">
                <h2 class="section-title">SẢN PHẨM NỔI BẬT</h2>
                <a href="/products" class="view-all">Xem tất cả <i class="fas fa-arrow-right"></i></a>
            </div>
            <div class="products-grid">
                <% if (locals.featuredProducts && featuredProducts.length > 0) { %>
                    <% for(var i = 0; i < featuredProducts.length; i++) { %>
                        <div class="product-card">
                            <div class="product-image">
                                <a href="/product/<%= featuredProducts[i].slug %>">
                                    <% if (featuredProducts[i].image) { %>
                                        <img src="<%= featuredProducts[i].image %>" alt="<%= featuredProducts[i].name %>">
                                    <% } else { %>
                                        <div class="no-image"><i class="fas fa-desktop fa-3x"></i></div>
                                    <% } %>
                                </a>
                                <% if (featuredProducts[i].oldPrice) { %>
                                    <span class="discount-badge">-<%= Math.round((1 - featuredProducts[i].price / featuredProducts[i].oldPrice) * 100) %>%</span>
                                <% } %>
                                <% if (featuredProducts[i].soldCount > 0) { %>
                                    <span class="sold-badge">Đã bán: <%= featuredProducts[i].soldCount %></span>
                                <% } %>
                            </div>
                            <div class="product-info">
                                <h3 class="product-name"><a href="/product/<%= featuredProducts[i].slug %>"><%= featuredProducts[i].name %></a></h3>
                                <div class="product-price">
                                    <span class="current-price"><%= featuredProducts[i].price.toLocaleString('vi-VN') %>đ</span>
                                    <% if (featuredProducts[i].oldPrice) { %>
                                        <span class="old-price"><%= featuredProducts[i].oldPrice.toLocaleString('vi-VN') %>đ</span>
                                    <% } %>
                                </div>
                                <div class="product-actions">
                                    <% if (locals.isLoggedIn) { %>
                                        <button class="add-to-cart-btn" onclick="addToCart('<%= featuredProducts[i]._id %>')"><i class="fas fa-shopping-cart"></i> Thêm vào giỏ</button>
                                    <% } else { %>
                                        <button class="add-to-cart-btn" onclick="alert('Vui lòng đăng nhập để mua hàng')"><i class="fas fa-shopping-cart"></i> Đăng nhập để mua</button>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } else { %>
                    <div style="grid-column: 1/-1; text-align: center; padding: 40px; color: #999;">
                        <i class="fas fa-box-open fa-3x" style="color:#ddd; margin-bottom:15px;"></i>
                        <p>Chưa có sản phẩm nào</p>
                    </div>
                <% } %>
            </div>
        </section>
    </div>

     <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-column">
                    <h4><i class="fas fa-store"></i> SHOWROOM - HÀ NỘI</h4>
                    <p>1A, Gốc Đề, Q.Hai Bà Trưng, Hà Nội</p>
                    <p>Tel: 034.567.8912</p>
                </div>
                <div class="footer-column">
                    <h4><i class="fas fa-store"></i> SHOWROOM - TP.HCM</h4>
                    <p>1A Cửu Long, P.15, Q.10, TP.HCM</p>
                    <p>Tel: 099.999.9999</p>
                </div>
                <div class="footer-column">
                    <h4><i class="fas fa-info-circle"></i> GIỚI THIỆU</h4>
                    <a href="#">Giới thiệu công ty</a>
                    <a href="#">Liên hệ</a>
                    <a href="#">Tin tức</a>
                </div>
                <div class="footer-column">
                    <h4><i class="fas fa-life-ring"></i> HỖ TRỢ</h4>
                    <a href="#">Hướng dẫn mua hàng</a>
                    <a href="#">Chính sách đổi trả</a>
                    <a href="#">Chính sách bảo hành</a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© 2026 PC MDZ - Cửa hàng máy tính chuyên nghiệp</p>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>