<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Báo cáo thống kê - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 25px;
            color: #ccc;
            text-decoration: none;
            transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .page-header h1 { font-size: 24px; color: #1a1a2e; }
        .search-box { display: flex; gap: 10px; background: white; padding: 5px 15px; border-radius: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .search-box input { border: none; padding: 10px; width: 250px; outline: none; }
        .search-box button { background: none; border: none; cursor: pointer; color: #e74c3c; font-size: 16px; }
        .filter-tabs { display: flex; gap: 10px; background: white; padding: 5px; border-radius: 40px; }
        .filter-btn { padding: 8px 20px; border: none; background: none; cursor: pointer; border-radius: 30px; }
        .filter-btn.active { background: #e74c3c; color: white; }
        .summary-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px; }
        .summary-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .summary-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            background: #fce4ec;
            color: #e91e63;
        }
        .summary-info h3 { font-size: 14px; color: #666; margin-bottom: 5px; }
        .summary-number { font-size: 24px; font-weight: bold; color: #1a1a2e; }
        .report-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            margin-bottom: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .report-card h3 { margin-bottom: 20px; font-size: 16px; color: #333; }
        .chart-container { position: relative; height: 350px; }
        .data-table { width: 100%; border-collapse: collapse; }
        .data-table th, .data-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .data-table th { background: #f8f9fa; font-weight: 600; }
        .price-cell { color: #e74c3c; font-weight: 500; }
        .empty-row { text-align: center; padding: 40px; color: #999; }
        @media (max-width: 992px) { .summary-cards { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
    <div class="sidebar-header">
        <i class="fas fa-store"></i>
        <h3>PC MDZ Admin</h3>
        <p>Chào, <%= user.fullName %></p>
    </div>
    <a href="/admin/dashboard" class="sidebar-link active"><i class="fas fa-chart-line"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
    <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
    <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
    <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
    <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
    <a href="/admin/staffs" class="sidebar-link"><i class="fas fa-user-tie"></i> Nhân viên</a>
    <a href="/admin/stock-requests" class="sidebar-link"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
    <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
    <hr class="sidebar-divider">
    <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
    <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
</div>
        
        <!-- Main Content -->
        <div class="admin-main">
            <div class="page-header">
                <h1><i class="fas fa-chart-bar"></i> Báo cáo thống kê</h1>
                <div class="filter-tabs">
                    <button class="filter-btn active" onclick="changeReportType('day')">Theo ngày</button>
                    <button class="filter-btn" onclick="changeReportType('month')">Theo tháng</button>
                    <button class="filter-btn" onclick="changeReportType('year')">Theo năm</button>
                </div>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm trong báo cáo...">
                    <button onclick="searchReport()"><i class="fas fa-search"></i></button>
                </div>
            </div>
            
            <!-- Tổng quan doanh thu -->
            <div class="summary-cards">
                <div class="summary-card">
                    <div class="summary-icon"><i class="fas fa-chart-line"></i></div>
                    <div class="summary-info">
                        <h3>Tổng doanh thu</h3>
                        <p class="summary-number" id="totalRevenue">0đ</p>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon"><i class="fas fa-shopping-cart"></i></div>
                    <div class="summary-info">
                        <h3>Số đơn đã giao</h3>
                        <p class="summary-number" id="completedOrders">0</p>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-icon"><i class="fas fa-tag"></i></div>
                    <div class="summary-info">
                        <h3>Giá trị trung bình</h3>
                        <p class="summary-number" id="avgOrderValue">0đ</p>
                    </div>
                </div>
            </div>
            
            <!-- Biểu đồ doanh thu -->
            <div class="report-card">
                <h3><i class="fas fa-chart-line"></i> Biểu đồ doanh thu</h3>
                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
            
            <!-- Bảng doanh thu -->
            <div class="report-card">
                <h3><i class="fas fa-table"></i> Chi tiết doanh thu</h3>
                <div style="overflow-x: auto;">
                    <table class="data-table" id="revenueTable">
                        <thead>
                            <tr><th>Thời gian</th><th>Số đơn hàng</th><th>Doanh thu</th></tr>
                        </thead>
                        <tbody id="revenueTableBody">
                            <tr><td colspan="3" class="empty-row">Đang tải dữ liệu...</div></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            <!-- Sản phẩm bán chạy -->
            <div class="report-card">
                <h3><i class="fas fa-fire"></i> Top sản phẩm bán chạy</h3>
                <div style="overflow-x: auto;">
                    <table class="data-table" id="bestSellersTable">
                        <thead>
                            <tr><th>STT</th><th>Sản phẩm</th><th>Danh mục</th><th>Đã bán</th><th>Doanh thu</th></tr>
                        </thead>
                        <tbody id="bestSellersTableBody">
                            <% if (bestSellers && bestSellers.length > 0) { %>
                                <% for(var i = 0; i < bestSellers.length; i++) { %>
                                <tr>
                                    <td><%= i + 1 %> </div></td>
                                    <td><%= bestSellers[i].name %> </div></td>
                                    <td><%= bestSellers[i].category ? bestSellers[i].category.name : 'Chưa phân loại' %> </div></td>
                                    <td><%= bestSellers[i].soldCount %> </div></td>
                                    <td class="price-cell"><%= (bestSellers[i].price * bestSellers[i].soldCount).toLocaleString('vi-VN') %>đ</div></td>
                                 </div>
                                <% } %>
                            <% } else { %>
                                <td><td colspan="5" class="empty-row">Chưa có dữ liệu</div></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentReportType = 'month';
        let revenueChart = null;
        
        function changeReportType(type) {
            currentReportType = type;
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            loadRevenueData();
        }
        
        function loadRevenueData() {
            fetch('/api/revenue-statistics?type=' + currentReportType)
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('totalRevenue').innerText = data.totalRevenue.toLocaleString('vi-VN') + 'đ';
                        document.getElementById('completedOrders').innerText = data.completedOrders;
                        const avgValue = data.completedOrders > 0 ? data.totalRevenue / data.completedOrders : 0;
                        document.getElementById('avgOrderValue').innerText = Math.round(avgValue).toLocaleString('vi-VN') + 'đ';
                        const reportData = currentReportType === 'day' ? data.dailyRevenue : (currentReportType === 'month' ? data.monthlyRevenue : data.yearlyRevenue);
                        const labels = reportData.map(item => item._id);
                        const revenues = reportData.map(item => item.revenue);
                        if (revenueChart) revenueChart.destroy();
                        revenueChart = new Chart(document.getElementById('revenueChart'), {
                            type: 'bar',
                            data: { labels: labels, datasets: [{ label: 'Doanh thu (đ)', data: revenues, backgroundColor: '#e74c3c', borderRadius: 8 }] },
                            options: { responsive: true, maintainAspectRatio: false }
                        });
                        const tbody = document.getElementById('revenueTableBody');
                        if (reportData.length > 0) {
                            tbody.innerHTML = reportData.map(item => `<tr><td><strong>${item._id}</strong></td><td>${item.count}</td><td class="price-cell">${item.revenue.toLocaleString('vi-VN')}đ</td></tr>`).join('');
                        } else {
                            tbody.innerHTML = '<tr><td colspan="3" class="empty-row">Chưa có dữ liệu</td></tr>';
                        }
                    }
                });
        }
        
        function searchReport() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#bestSellersTableBody tr');
            let hasResults = false;
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(searchText)) { row.style.display = ''; hasResults = true; }
                else { row.style.display = 'none'; }
            });
            const noResultRow = document.getElementById('noResultRow');
            if (noResultRow) noResultRow.remove();
            if (!hasResults && searchText !== '') {
                const tbody = document.getElementById('bestSellersTableBody');
                const newNoResultRow = document.createElement('tr');
                newNoResultRow.id = 'noResultRow';
                newNoResultRow.innerHTML = '<td colspan="5" class="empty-row">Không tìm thấy sản phẩm nào</td>';
                tbody.appendChild(newNoResultRow);
            }
        }
        
        document.getElementById('searchInput').addEventListener('keypress', function(e) { if (e.key === 'Enter') searchReport(); });
        loadRevenueData();
    </script>
</body>
</html>