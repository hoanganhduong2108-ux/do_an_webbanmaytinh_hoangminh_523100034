<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title><%= title %> - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .admin-container { display: flex; }
        .admin-sidebar { width: 280px; background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%); min-height: 100vh; padding: 25px 0; }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link { display: flex; align-items: center; gap: 12px; padding: 12px 25px; color: #ccc; text-decoration: none; transition: all 0.3s; }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .page-header h1 { font-size: 24px; color: #1a1a2e; }
        .btn-primary { background: #e74c3c; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-secondary { background: #ffc107; color: #333; padding: 5px 12px; border-radius: 5px; text-decoration: none; font-size: 12px; }
        .btn-info { background: #17a2b8; color: white; padding: 5px 12px; border-radius: 5px; text-decoration: none; font-size: 12px; }
        .staff-table { width: 100%; background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
        .staff-table th, .staff-table td { padding: 14px 12px; text-align: left; border-bottom: 1px solid #eee; }
        .staff-table th { background: #f8f9fa; font-weight: 600; font-size: 13px; }
        .status-active { background: #28a745; color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; }
        .status-inactive { background: #dc3545; color: white; padding: 4px 10px; border-radius: 20px; font-size: 11px; }
        .empty-row { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar admin (copy từ admin/dashboard.ejs) -->
        <div class="admin-sidebar">
            <div class="sidebar-header">
                <i class="fas fa-store"></i>
                <h3>PC MDZ Admin</h3>
                <p>Chào, <%= user.fullName %></p>
            </div>
            <a href="/admin/dashboard" class="sidebar-link"><i class="fas fa-chart-line"></i> Dashboard</a>
            <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
            <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
            <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
            <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
            <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
            <a href="/admin/staffs" class="sidebar-link active"><i class="fas fa-user-tie"></i> Nhân viên</a>
            <a href="/admin/stock-requests" class="sidebar-link"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
            <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
            <hr class="sidebar-divider">
            <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
            <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
        </div>
        
        <div class="admin-main">
            <div class="page-header">
                <h1><i class="fas fa-user-tie"></i> Quản lý nhân viên</h1>
                <a href="/admin/staffs/create" class="btn-primary">
                    <i class="fas fa-plus"></i> Thêm nhân viên
                </a>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="staff-table">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã NV</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>SĐT</th>
                            <th>Bộ phận</th>
                            <th>Đơn xử lý</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (staffs && staffs.length > 0) { %>
                            <% staffs.forEach((s, i) => { %>
                            <tr>
                                <td><%= i + 1 %></td>
                                <td><strong><%= s.staffCode || 'N/A' %></strong></td>
                                <td><%= s.fullName %></td>
                                <td><%= s.email %></td>
                                <td><%= s.phone %></td>
                                <td><%= s.department || 'sales' %></td>
                                <td><%= s.ordersProcessed || 0 %></td>
                                <td>
                                    <span class="<%= s.isActive ? 'status-active' : 'status-inactive' %>">
                                        <%= s.isActive ? 'Hoạt động' : 'Đã khóa' %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/admin/staffs/edit/<%= s._id %>" class="btn-secondary">
                                        <i class="fas fa-edit"></i> Sửa
                                    </a>
                                    <form method="POST" action="/admin/staffs/<%= s._id %>/toggle?_method=PUT" style="display:inline;">
                                        <button type="submit" class="btn-info" style="border:none;cursor:pointer;">
                                            <i class="fas fa-<%= s.isActive ? 'ban' : 'check' %>"></i>
                                            <%= s.isActive ? 'Khóa' : 'Mở' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr><td colspan="9" class="empty-row">Chưa có nhân viên nào</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>