<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý khách hàng - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 25px;
            color: #ccc;
            text-decoration: none;
            transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .page-header h1 { font-size: 24px; color: #1a1a2e; }
        .search-box { display: flex; gap: 10px; background: white; padding: 5px 15px; border-radius: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .search-box input { border: none; padding: 10px; width: 250px; outline: none; }
        .search-box button { background: none; border: none; cursor: pointer; color: #e74c3c; font-size: 16px; }
        .btn-secondary { background: #ffc107; color: #333; padding: 5px 10px; border-radius: 5px; border: none; cursor: pointer; }
        .btn-danger { background: #dc3545; color: white; padding: 5px 10px; border-radius: 5px; border: none; cursor: pointer; }
        .customer-table { width: 100%; background: white; border-radius: 10px; overflow: hidden; }
        .customer-table th, .customer-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .customer-table th { background: #f8f9fa; font-weight: 600; }
        .status-active { background: #28a745; color: white; padding: 4px 8px; border-radius: 5px; font-size: 11px; display: inline-block; }
        .status-inactive { background: #dc3545; color: white; padding: 4px 8px; border-radius: 5px; font-size: 11px; display: inline-block; }
        .empty-row { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
    <div class="sidebar-header">
        <i class="fas fa-store"></i>
        <h3>PC MDZ Admin</h3>
        <p>Chào, <%= user.fullName %></p>
    </div>
    <a href="/admin/dashboard" class="sidebar-link active"><i class="fas fa-chart-line"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
    <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
    <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
    <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
    <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
    <a href="/admin/staffs" class="sidebar-link"><i class="fas fa-user-tie"></i> Nhân viên</a>
    <a href="/admin/stock-requests" class="sidebar-link"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
    <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
    <hr class="sidebar-divider">
    <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
    <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
</div>
        
        <!-- Main Content -->
        <div class="admin-main">
            <div class="page-header">
                <h1><i class="fas fa-users"></i> Quản lý khách hàng</h1>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm khách hàng...">
                    <button onclick="searchCustomers()"><i class="fas fa-search"></i></button>
                </div>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="customer-table" id="customersTable">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Địa chỉ</th>
                            <th>Ngày đăng ký</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="customersTableBody">
                        <% for(var i = 0; i < customers.length; i++) { %>
                        <tr>
                            <td><%= i + 1 %> </div></td>
                            <td><%= customers[i].fullName %> </div></td>
                            <td><%= customers[i].email %> </div></td>
                            <td><%= customers[i].phone %> </div></td>
                            <td><%= customers[i].address %> </div></td>
                            <td><%= new Date(customers[i].createdAt).toLocaleDateString('vi-VN') %> </div></td>
                            <td>
                                <span class="<%= customers[i].isActive ? 'status-active' : 'status-inactive' %>">
                                    <%= customers[i].isActive ? 'Hoạt động' : 'Đã khóa' %>
                                </span>
                             </div>
                            <td>
                                <form method="POST" action="/admin/customers/<%= customers[i]._id %>/toggle?_method=PUT" style="display:inline;">
                                    <button type="submit" class="btn-secondary">
                                        <i class="fas fa-<%= customers[i].isActive ? 'ban' : 'check' %>"></i>
                                        <%= customers[i].isActive ? 'Khóa' : 'Mở khóa' %>
                                    </button>
                                </form>
                                <form method="POST" action="/admin/customers/<%= customers[i]._id %>?_method=DELETE" style="display:inline;" onsubmit="return confirm('Xóa khách hàng này?')">
                                    <button type="submit" class="btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                                </form>
                             </div>
                         </div>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function searchCustomers() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#customersTableBody tr');
            let hasResults = false;
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(searchText)) { row.style.display = ''; hasResults = true; }
                else { row.style.display = 'none'; }
            });
            if (!hasResults && searchText !== '') {
                const tbody = document.getElementById('customersTableBody');
                if (document.getElementById('noResultRow')) return;
                const noResultRow = document.createElement('tr');
                noResultRow.id = 'noResultRow';
                noResultRow.innerHTML = '<td colspan="8" class="empty-row">Không tìm thấy khách hàng nào</td>';
                tbody.appendChild(noResultRow);
            } else {
                const noResultRow = document.getElementById('noResultRow');
                if (noResultRow) noResultRow.remove();
            }
        }
        document.getElementById('searchInput').addEventListener('keypress', function(e) { if (e.key === 'Enter') searchCustomers(); });
    </script>
</body>
</html>