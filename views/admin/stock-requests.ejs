<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ===== LAYOUT ===== */
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex; align-items: center; gap: 12px;
            padding: 12px 25px; color: #ccc; text-decoration: none;
            transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        
        /* ===== FILTER ===== */
        .filter-bar { margin-bottom: 20px; }
        .filter-bar label { font-weight: 500; font-size: 14px; margin-right: 8px; }
        .filter-bar select {
            padding: 8px 15px; border: 1px solid #ddd;
            border-radius: 8px; font-size: 14px;
        }
        
        /* ===== TABLE ===== */
        .requests-table {
            width: 100%; background: white; border-radius: 12px;
            overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-collapse: collapse;
        }
        .requests-table th, .requests-table td {
            padding: 14px 12px; text-align: left;
            border-bottom: 1px solid #eee; font-size: 13px;
        }
        .requests-table th {
            background: #f8f9fa; font-weight: 600;
            color: #555; font-size: 13px;
        }
        .requests-table tbody tr:hover { background: #fafafa; }
        
        /* ===== STATUS BADGE ===== */
        .status-badge {
            padding: 5px 12px; border-radius: 20px;
            font-size: 12px; font-weight: 500; display: inline-block;
        }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-approved { background: #cce5ff; color: #004085; }
        .status-rejected { background: #f8d7da; color: #721c24; }
        .status-imported { background: #d4edda; color: #155724; }
        
        /* ===== BUTTONS ===== */
        .btn-approve {
            background: #28a745; color: white; border: none;
            padding: 5px 12px; border-radius: 5px; cursor: pointer;
            font-size: 12px;
        }
        .btn-approve:hover { background: #218838; }
        .btn-reject {
            background: #dc3545; color: white; border: none;
            padding: 5px 12px; border-radius: 5px; cursor: pointer;
            font-size: 12px;
        }
        .btn-reject:hover { background: #c82333; }
        
        /* ===== EMPTY STATE ===== */
        .empty-row { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="admin-container">
        <div class="admin-sidebar">
            <div class="sidebar-header">
                <i class="fas fa-store"></i>
                <h3>PC MDZ Admin</h3>
                <p>Chào, <%= user.fullName %></p>
            </div>
            <a href="/admin/dashboard" class="sidebar-link"><i class="fas fa-chart-line"></i> Dashboard</a>
            <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
            <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
            <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
            <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
            <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
            <a href="/admin/staffs" class="sidebar-link"><i class="fas fa-user-tie"></i> Nhân viên</a>
            <a href="/admin/stock-requests" class="sidebar-link active"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
            <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
            <hr class="sidebar-divider">
            <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
            <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
        </div>
        
        <div class="admin-main">
            <h1 style="margin-bottom: 20px; font-size: 24px; color: #1a1a2e;">
                <i class="fas fa-warehouse"></i> Duyệt đề xuất nhập hàng
            </h1>
            
            <div class="filter-bar">
                <label>Lọc theo trạng thái: </label>
                <select onchange="window.location.href='/admin/stock-requests?status=' + this.value">
                    <option value="all" <%= currentStatus === 'all' ? 'selected' : '' %>>Tất cả</option>
                    <option value="Chờ duyệt" <%= currentStatus === 'Chờ duyệt' ? 'selected' : '' %>>Chờ duyệt</option>
                    <option value="Đã duyệt" <%= currentStatus === 'Đã duyệt' ? 'selected' : '' %>>Đã duyệt</option>
                    <option value="Từ chối" <%= currentStatus === 'Từ chối' ? 'selected' : '' %>>Từ chối</option>
                    <option value="Đã nhập hàng" <%= currentStatus === 'Đã nhập hàng' ? 'selected' : '' %>>Đã nhập hàng</option>
                </select>
            </div>
            
            <table class="requests-table">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Sản phẩm</th>
                        <th>Tồn hiện tại</th>
                        <th>SL đề xuất</th>
                        <th>NV đề xuất</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (requests && requests.length > 0) { %>
                        <% requests.forEach((r, i) => { 
                            var statusClass = '';
                            if (r.status === 'Chờ duyệt') statusClass = 'status-pending';
                            else if (r.status === 'Đã duyệt') statusClass = 'status-approved';
                            else if (r.status === 'Từ chối') statusClass = 'status-rejected';
                            else statusClass = 'status-imported';
                        %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><%= r.product ? r.product.name : 'N/A' %></td>
                            <td><%= r.currentStock %></td>
                            <td><strong style="color:#e74c3c;">+<%= r.requestedQuantity %></strong></td>
                            <td>
                                <%= r.requestedBy ? r.requestedBy.fullName : 'N/A' %>
                                <br><small style="color:#666;"><%= r.requestedBy ? r.requestedBy.staffCode : '' %></small>
                            </td>
                            <td><%= r.reason || '-' %></td>
                            <td><span class="status-badge <%= statusClass %>"><%= r.status %></span></td>
                            <td>
                                <% if (r.status === 'Chờ duyệt') { %>
                                    <form method="POST" action="/admin/stock-requests/<%= r._id %>?_method=PUT" style="display:inline;">
                                        <input type="hidden" name="status" value="Đã nhập hàng">
                                        <input type="hidden" name="reviewNote" value="Đã duyệt và nhập hàng">
                                        <button type="submit" class="btn-approve" onclick="return confirm('Duyệt và nhập hàng?')">
                                            <i class="fas fa-check"></i> Duyệt
                                        </button>
                                    </form>
                                    <form method="POST" action="/admin/stock-requests/<%= r._id %>?_method=PUT" style="display:inline;">
                                        <input type="hidden" name="status" value="Từ chối">
                                        <input type="hidden" name="reviewNote" value="Không duyệt">
                                        <button type="submit" class="btn-reject" onclick="return confirm('Từ chối đề xuất?')">
                                            <i class="fas fa-times"></i> Từ chối
                                        </button>
                                    </form>
                                <% } else { %>
                                    <span style="color:#999;font-size:12px;">
                                        <%= r.reviewNote || 'Đã xử lý' %>
                                        <% if (r.reviewedBy) { %>
                                            <br>bởi <%= r.reviewedBy.fullName %>
                                        <% } %>
                                    </span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="8" class="empty-row">Chưa có đề xuất nào</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>