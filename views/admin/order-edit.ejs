<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa thông tin đơn hàng - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: #1a1a2e;
            min-height: 100vh;
            padding: 20px;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: block;
            color: white;
            padding: 12px 15px;
            text-decoration: none;
            border-radius: 8px;
            margin-bottom: 5px;
        }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); }
        .sidebar-link.active { background: #e74c3c; }
        .sidebar-divider { border-color: #333; margin: 20px 0; }
        .admin-main { flex: 1; padding: 20px; background: #f5f7fa; }
        .form-container { max-width: 800px; margin: 0 auto; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; }
        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
        }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .btn-save { background: #e74c3c; color: white; padding: 12px 25px; border: none; border-radius: 8px; cursor: pointer; }
        .btn-cancel { background: #6c757d; color: white; padding: 12px 25px; border: none; border-radius: 8px; text-decoration: none; display: inline-block; }
        .required { color: #e74c3c; }
        .items-table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        .items-table th, .items-table td { padding: 10px; text-align: left; border-bottom: 1px solid #eee; }
        .items-table th { background: #f8f9fa; font-weight: 600; }
        .total-amount { color: #e74c3c; font-size: 18px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
    <div class="sidebar-header">
        <i class="fas fa-store"></i>
        <h3>PC MDZ Admin</h3>
        <p>Chào, <%= user.fullName %></p>
    </div>
    <a href="/admin/dashboard" class="sidebar-link active"><i class="fas fa-chart-line"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
    <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
    <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
    <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
    <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
    <a href="/admin/staffs" class="sidebar-link"><i class="fas fa-user-tie"></i> Nhân viên</a>
    <a href="/admin/stock-requests" class="sidebar-link"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
    <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
    <hr class="sidebar-divider">
    <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
    <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
</div>
        
        <!-- Main Content -->
        <div class="admin-main">
            <div class="form-container">
                <a href="/admin/orders/<%= order._id %>" class="btn-cancel" style="margin-bottom: 20px; display: inline-block;"><i class="fas fa-arrow-left"></i> Quay lại</a>
                <h1><i class="fas fa-edit"></i> Sửa thông tin đơn hàng</h1>
                <p>Mã đơn: <strong><%= order.orderCode %></strong></p>
                
                <form method="POST" action="/admin/orders/<%= order._id %>?_method=PUT" style="background: white; padding: 30px; border-radius: 12px;">
                    <div class="form-row">
                        <div class="form-group">
                            <label>Họ tên khách hàng</label>
                            <input type="text" name="fullName" value="<%= order.fullName %>" required>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" name="email" value="<%= order.email %>" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Số điện thoại</label>
                            <input type="tel" name="phone" value="<%= order.phone %>" required>
                        </div>
                        <div class="form-group">
                            <label>Địa chỉ giao hàng</label>
                            <input type="text" name="address" value="<%= order.address %>" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Phí vận chuyển (đ)</label>
                            <input type="number" name="shippingFee" value="<%= order.shippingFee %>">
                        </div>
                        <div class="form-group">
                            <label>Giảm giá (đ)</label>
                            <input type="number" name="discount" value="<%= order.discount %>">
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label>Phương thức thanh toán</label>
                            <select name="paymentMethod">
                                <option value="cod" <%= order.paymentMethod === 'cod' ? 'selected' : '' %>>COD</option>
                                <option value="banking" <%= order.paymentMethod === 'banking' ? 'selected' : '' %>>Chuyển khoản</option>
                                <option value="momo" <%= order.paymentMethod === 'momo' ? 'selected' : '' %>>MoMo</option>
                                <option value="zalopay" <%= order.paymentMethod === 'zalopay' ? 'selected' : '' %>>ZaloPay</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Trạng thái</label>
                            <select name="status" disabled style="background: #f0f0f0;">
                                <option value="Chờ xác nhận" <%= order.orderStatus === 'Chờ xác nhận' ? 'selected' : '' %>>Chờ xác nhận</option>
                                <option value="Đã xác nhận" <%= order.orderStatus === 'Đã xác nhận' ? 'selected' : '' %>>Đã xác nhận</option>
                                <option value="Đang chuẩn bị" <%= order.orderStatus === 'Đang chuẩn bị' ? 'selected' : '' %>>Đang chuẩn bị</option>
                                <option value="Đang giao hàng" <%= order.orderStatus === 'Đang giao hàng' ? 'selected' : '' %>>Đang giao hàng</option>
                                <option value="Đã giao hàng" <%= order.orderStatus === 'Đã giao hàng' ? 'selected' : '' %>>Đã giao hàng</option>
                                <option value="Đã hủy" <%= order.orderStatus === 'Đã hủy' ? 'selected' : '' %>>Đã hủy</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label>Ghi chú đơn hàng</label>
                        <textarea name="note" rows="3"><%= order.note || '' %></textarea>
                    </div>
                    
                    <h3 style="margin-top: 30px;">Danh sách sản phẩm</h3>
                    <table class="items-table">
                        <thead>
                            <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            <% for(var i = 0; i < order.items.length; i++) { %>
                            <tr>
                                <td><%= order.items[i].productName %></td>
                                <td><%= order.items[i].price.toLocaleString('vi-VN') %>đ</div></td>
                                <td><%= order.items[i].quantity %></div></td>
                                <td><%= (order.items[i].price * order.items[i].quantity).toLocaleString('vi-VN') %>đ</div></td>
                            </tr>
                            <% } %>
                        </tbody>
                        <tfoot>
                            <tr><td colspan="3"><strong>Tạm tính:</strong></td><td><%= order.subtotal.toLocaleString('vi-VN') %>đ</div></td>
                            <tr><td colspan="3"><strong>Phí vận chuyển:</strong></div><td><%= order.shippingFee.toLocaleString('vi-VN') %>đ</div></td>
                            <tr><td colspan="3"><strong>Giảm giá:</strong></div><td><%= order.discount.toLocaleString('vi-VN') %>đ</div></td>
                            <tr><td colspan="3"><strong>Tổng cộng:</strong></td><td class="total-amount"><%= order.total.toLocaleString('vi-VN') %>đ</div></td>
                        </tfoot>
                    </table>
                    
                    <div style="display: flex; gap: 15px; margin-top: 25px;">
                        <button type="submit" class="btn-save"><i class="fas fa-save"></i> Lưu thay đổi</button>
                        <a href="/admin/orders/<%= order._id %>" class="btn-cancel"><i class="fas fa-times"></i> Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>