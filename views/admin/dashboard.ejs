<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #f5f7fa; }
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
            position: sticky;
            top: 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 25px;
            color: #ccc;
            text-decoration: none;
            transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px; }
        .admin-header h1 { font-size: 24px; color: #1a1a2e; }
        .search-box { display: flex; gap: 10px; background: white; padding: 5px 15px; border-radius: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .search-box input { border: none; padding: 10px; width: 250px; outline: none; }
        .search-box button { background: none; border: none; cursor: pointer; color: #e74c3c; font-size: 16px; }
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 30px; }
        .stat-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            transition: transform 0.3s;
        }
        .stat-card:hover { transform: translateY(-3px); }
        .stat-info h4 { font-size: 14px; color: #666; margin-bottom: 8px; }
        .stat-number { font-size: 28px; font-weight: bold; color: #1a1a2e; }
        .stat-icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        .stat-card:nth-child(1) .stat-icon { background: #fff3e0; color: #ff9800; }
        .stat-card:nth-child(2) .stat-icon { background: #e3f2fd; color: #2196f3; }
        .stat-card:nth-child(3) .stat-icon { background: #e8f5e9; color: #4caf50; }
        .stat-card:nth-child(4) .stat-icon { background: #fce4ec; color: #e91e63; }
        .dashboard-charts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px; }
        .chart-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .chart-card h3 { font-size: 16px; margin-bottom: 20px; color: #333; }
        .chart-container { position: relative; height: 280px; }
        .recent-orders-section {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            flex-wrap: wrap;
            gap: 10px;
        }
        .section-header h2 { font-size: 18px; color: #333; }
        .btn-view-all { color: #e74c3c; text-decoration: none; font-size: 13px; }
        .orders-table { width: 100%; border-collapse: collapse; }
        .orders-table th, .orders-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .orders-table th { background: #f8f9fa; font-weight: 600; color: #555; }
        .status-badge { padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: 500; }
        .status-pending { background: #fff3cd; color: #856404; }
        .status-confirmed { background: #cce5ff; color: #004085; }
        .status-preparing { background: #d4edda; color: #155724; }
        .status-shipping { background: #d1ecf1; color: #0c5460; }
        .status-delivered { background: #d4edda; color: #155724; }
        .status-cancelled { background: #f8d7da; color: #721c24; }
        .price-cell { color: #e74c3c; font-weight: 500; }
        .btn-sm { padding: 5px 12px; border-radius: 6px; font-size: 12px; text-decoration: none; background: #e74c3c; color: white; }
        .btn-sm:hover { background: #c0392b; }
        .empty-row { text-align: center; padding: 40px; color: #999; }
        @media (max-width: 992px) {
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .dashboard-charts { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
    <div class="sidebar-header">
        <i class="fas fa-store"></i>
        <h3>PC MDZ Admin</h3>
        <p>Chào, <%= user.fullName %></p>
    </div>
    <a href="/admin/dashboard" class="sidebar-link active"><i class="fas fa-chart-line"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
    <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
    <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
    <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
    <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
    <a href="/admin/staffs" class="sidebar-link"><i class="fas fa-user-tie"></i> Nhân viên</a>
    <a href="/admin/stock-requests" class="sidebar-link"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
    <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
    <hr class="sidebar-divider">
    <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
    <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
</div>
        
        <!-- Main Content -->
        <div class="admin-main">
            <div class="admin-header">
                <h1><i class="fas fa-chart-line"></i> Bảng điều khiển</h1>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm đơn hàng...">
                    <button onclick="searchOrders()"><i class="fas fa-search"></i></button>
                </div>
            </div>
            
            <!-- Thống kê nhanh -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Tổng đơn hàng</h4>
                        <div class="stat-number"><%= totalOrders %></div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Tổng sản phẩm</h4>
                        <div class="stat-number"><%= totalProducts %></div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-box"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Tổng khách hàng</h4>
                        <div class="stat-number"><%= totalCustomers %></div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                </div>
                <div class="stat-card">
                    <div class="stat-info">
                        <h4>Doanh thu thực tế</h4>
                        <div class="stat-number" id="totalRevenue">0đ</div>
                        <small>Số đơn đã giao: <span id="completedOrders">0</span></small>
                    </div>
                    <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
                </div>
            </div>
            
            <!-- Biểu đồ -->
            <div class="dashboard-charts">
                <div class="chart-card">
                    <h3><i class="fas fa-chart-line"></i> Doanh thu 7 ngày qua</h3>
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
                <div class="chart-card">
                    <h3><i class="fas fa-chart-pie"></i> Trạng thái đơn hàng</h3>
                    <div class="chart-container">
                        <canvas id="orderStatusChart"></canvas>
                    </div>
                </div>
            </div>
            
            <!-- Đơn hàng gần đây -->
            <div class="recent-orders-section">
                <div class="section-header">
                    <h2><i class="fas fa-clock"></i> Đơn hàng gần đây</h2>
                    <a href="/admin/orders" class="btn-view-all">Xem tất cả <i class="fas fa-arrow-right"></i></a>
                </div>
                <div style="overflow-x: auto;">
                    <table class="orders-table" id="ordersTable">
                        <thead>
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Số điện thoại</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày đặt</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody">
                            <% if (recentOrders && recentOrders.length > 0) { %>
                                <% for(var i = 0; i < recentOrders.length; i++) { 
                                    var statusClass = '';
                                    if (recentOrders[i].orderStatus === 'Chờ xác nhận') statusClass = 'status-pending';
                                    else if (recentOrders[i].orderStatus === 'Đã xác nhận') statusClass = 'status-confirmed';
                                    else if (recentOrders[i].orderStatus === 'Đang chuẩn bị') statusClass = 'status-preparing';
                                    else if (recentOrders[i].orderStatus === 'Đang giao hàng') statusClass = 'status-shipping';
                                    else if (recentOrders[i].orderStatus === 'Đã giao hàng') statusClass = 'status-delivered';
                                    else statusClass = 'status-cancelled';
                                %>
                                <tr>
                                    <td><strong><%= recentOrders[i].orderCode %></strong></td>
                                    <td><%= recentOrders[i].fullName %></td>
                                    <td><%= recentOrders[i].phone %></td>
                                    <td class="price-cell"><%= recentOrders[i].total.toLocaleString('vi-VN') %>đ</td>
                                    <td><span class="status-badge <%= statusClass %>"><%= recentOrders[i].orderStatus %></span></td>
                                    <td><%= new Date(recentOrders[i].createdAt).toLocaleDateString('vi-VN') %></td>
                                    <td><a href="/admin/orders/<%= recentOrders[i]._id %>" class="btn-sm">Chi tiết</a></td>
                                </tr>
                                <% } %>
                            <% } else { %>
                                <tr><td colspan="7" class="empty-row">Chưa có đơn hàng nào</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function searchOrders() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#ordersTableBody tr');
            let hasResults = false;
            
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(searchText)) {
                    row.style.display = '';
                    hasResults = true;
                } else {
                    row.style.display = 'none';
                }
            });
            
            if (!hasResults && searchText !== '') {
                const tbody = document.getElementById('ordersTableBody');
                if (document.getElementById('noResultRow')) return;
                const noResultRow = document.createElement('tr');
                noResultRow.id = 'noResultRow';
                noResultRow.innerHTML = '<td colspan="7" class="empty-row">Không tìm thấy đơn hàng nào</td>';
                tbody.appendChild(noResultRow);
            } else {
                const noResultRow = document.getElementById('noResultRow');
                if (noResultRow) noResultRow.remove();
            }
        }
        
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') searchOrders();
        });
        
        function loadRevenueData() {
            fetch('/api/revenue-statistics')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('totalRevenue').innerText = data.totalRevenue.toLocaleString('vi-VN') + 'đ';
                        document.getElementById('completedOrders').innerText = data.completedOrders;
                        const dailyData = data.dailyRevenue || [];
                        const labels = dailyData.map(item => item._id);
                        const revenues = dailyData.map(item => item.revenue);
                        new Chart(document.getElementById('revenueChart'), {
                            type: 'line',
                            data: { labels: labels, datasets: [{ label: 'Doanh thu (đ)', data: revenues, borderColor: '#e74c3c', backgroundColor: 'rgba(231,76,60,0.1)', fill: true, tension: 0.4 }] },
                            options: { responsive: true, maintainAspectRatio: false }
                        });
                    }
                });
        }
        
        function loadOrderStatusChart() {
            fetch('/api/order-statistics')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        new Chart(document.getElementById('orderStatusChart'), {
                            type: 'doughnut',
                            data: { labels: ['Chờ xác nhận', 'Đã xác nhận', 'Đang chuẩn bị', 'Đang giao', 'Đã giao', 'Đã hủy'], datasets: [{ data: [data.pending, data.confirmed, data.preparing, data.shipping, data.delivered, data.cancelled], backgroundColor: ['#ffc107', '#17a2b8', '#fd7e14', '#6f42c1', '#28a745', '#dc3545'] }] },
                            options: { responsive: true, maintainAspectRatio: false }
                        });
                    }
                });
        }
        
        document.addEventListener('DOMContentLoaded', function() { loadRevenueData(); loadOrderStatusChart(); });
    </script>
</body>
</html>