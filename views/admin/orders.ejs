<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý đơn hàng - PC MDZ Admin</title>
    <link rel="stylesheet" href="/css/new-style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .admin-container { display: flex; }
        .admin-sidebar {
            width: 280px;
            background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
            min-height: 100vh;
            padding: 25px 0;
        }
        .sidebar-header { text-align: center; margin-bottom: 30px; padding: 0 20px; }
        .sidebar-header i { font-size: 50px; color: #e74c3c; }
        .sidebar-header h3 { color: white; margin-top: 10px; font-size: 18px; }
        .sidebar-header p { color: #aaa; font-size: 12px; }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 25px;
            color: #ccc;
            text-decoration: none;
            transition: all 0.3s;
        }
        .sidebar-link i { width: 20px; font-size: 16px; }
        .sidebar-link:hover { background: rgba(231,76,60,0.2); color: white; padding-left: 30px; }
        .sidebar-link.active { background: #e74c3c; color: white; }
        .sidebar-divider { margin: 20px 25px; border-color: #333; }
        .admin-main { flex: 1; padding: 25px; background: #f5f7fa; }
        .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .page-header h1 { font-size: 24px; color: #1a1a2e; }
        .search-box { display: flex; gap: 10px; background: white; padding: 5px 15px; border-radius: 40px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .search-box input { border: none; padding: 10px; width: 250px; outline: none; }
        .search-box button { background: none; border: none; cursor: pointer; color: #e74c3c; font-size: 16px; }
        .filter-bar { margin-bottom: 20px; display: flex; gap: 15px; align-items: center; flex-wrap: wrap; }
        .filter-bar select { padding: 8px 15px; border: 1px solid #ddd; border-radius: 8px; }
        .btn-secondary { background: #6c757d; color: white; padding: 5px 10px; border-radius: 5px; text-decoration: none; font-size: 12px; }
        .btn-primary { background: #007bff; color: white; padding: 5px 10px; border-radius: 5px; text-decoration: none; font-size: 12px; }
        .btn-danger { background: #dc3545; color: white; padding: 5px 10px; border-radius: 5px; border: none; cursor: pointer; font-size: 12px; }
        .orders-table { width: 100%; background: white; border-radius: 10px; overflow: hidden; }
        .orders-table th, .orders-table td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        .orders-table th { background: #f8f9fa; font-weight: 600; }
        .status-badge { padding: 5px 10px; border-radius: 5px; font-size: 12px; }
        .status-pending { background: #ffc107; color: #333; }
        .status-confirmed { background: #17a2b8; color: white; }
        .status-preparing { background: #fd7e14; color: white; }
        .status-shipping { background: #6f42c1; color: white; }
        .status-delivered { background: #28a745; color: white; }
        .status-cancelled { background: #dc3545; color: white; }
        .price-cell { color: #e74c3c; font-weight: 500; }
        .empty-row { text-align: center; padding: 40px; color: #999; }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="admin-sidebar">
    <div class="sidebar-header">
        <i class="fas fa-store"></i>
        <h3>PC MDZ Admin</h3>
        <p>Chào, <%= user.fullName %></p>
    </div>
    <a href="/admin/dashboard" class="sidebar-link active"><i class="fas fa-chart-line"></i> Dashboard</a>
    <a href="/admin/products" class="sidebar-link"><i class="fas fa-box"></i> Sản phẩm</a>
    <a href="/admin/categories" class="sidebar-link"><i class="fas fa-folder"></i> Danh mục</a>
    <a href="/admin/orders" class="sidebar-link"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
    <a href="/admin/customers" class="sidebar-link"><i class="fas fa-users"></i> Khách hàng</a>
    <a href="/admin/vouchers" class="sidebar-link"><i class="fas fa-ticket-alt"></i> Mã giảm giá</a>
    <a href="/admin/staffs" class="sidebar-link"><i class="fas fa-user-tie"></i> Nhân viên</a>
    <a href="/admin/stock-requests" class="sidebar-link"><i class="fas fa-warehouse"></i> Đề xuất nhập hàng</a>
    <a href="/admin/reports" class="sidebar-link"><i class="fas fa-chart-bar"></i> Báo cáo</a>
    <hr class="sidebar-divider">
    <a href="/" class="sidebar-link"><i class="fas fa-home"></i> Về trang chủ</a>
    <a href="/logout" class="sidebar-link"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a>
</div>
        
        <!-- Main Content -->
        <div class="admin-main">
            <div class="page-header">
                <h1><i class="fas fa-shopping-cart"></i> Quản lý đơn hàng</h1>
                <div class="search-box">
                    <input type="text" id="searchInput" placeholder="Tìm kiếm đơn hàng...">
                    <button onclick="searchOrders()"><i class="fas fa-search"></i></button>
                </div>
            </div>
            
            <div class="filter-bar">
                <label>Lọc theo trạng thái: </label>
                <select id="statusFilter" onchange="filterOrders()">
                    <option value="all">Tất cả</option>
                    <option value="Chờ xác nhận">Chờ xác nhận</option>
                    <option value="Đã xác nhận">Đã xác nhận</option>
                    <option value="Đang chuẩn bị">Đang chuẩn bị</option>
                    <option value="Đang giao hàng">Đang giao hàng</option>
                    <option value="Đã giao hàng">Đã giao hàng</option>
                    <option value="Đã hủy">Đã hủy</option>
                </select>
                <label>Lọc theo ngày: </label>
                <input type="date" id="dateFilter" onchange="filterOrders()">
                <button onclick="resetFilters()" class="btn-secondary">Xóa bộ lọc</button>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="orders-table" id="ordersTable">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody">
                        <% for(var i = 0; i < orders.length; i++) { 
                            var statusClass = '';
                            if (orders[i].orderStatus === 'Chờ xác nhận') statusClass = 'status-pending';
                            else if (orders[i].orderStatus === 'Đã xác nhận') statusClass = 'status-confirmed';
                            else if (orders[i].orderStatus === 'Đang chuẩn bị') statusClass = 'status-preparing';
                            else if (orders[i].orderStatus === 'Đang giao hàng') statusClass = 'status-shipping';
                            else if (orders[i].orderStatus === 'Đã giao hàng') statusClass = 'status-delivered';
                            else statusClass = 'status-cancelled';
                        %>
                        <tr>
                            <td><strong><%= orders[i].orderCode %></strong></td>
                            <td><%= orders[i].fullName %></td>
                            <td><%= orders[i].phone %></td>
                            <td class="price-cell"><%= orders[i].total.toLocaleString('vi-VN') %>đ</div></td>
                            <td><span class="status-badge <%= statusClass %>"><%= orders[i].orderStatus %></span></td>
                            <td><%= new Date(orders[i].createdAt).toLocaleDateString('vi-VN') %> </div></td>
                            <td>
                                <a href="/admin/orders/<%= orders[i]._id %>" class="btn-secondary"><i class="fas fa-eye"></i> Chi tiết</a>
                                <a href="/admin/orders/<%= orders[i]._id %>/edit" class="btn-primary"><i class="fas fa-edit"></i> Sửa</a>
                                <% if (orders[i].orderStatus === 'Đã giao hàng' || orders[i].orderStatus === 'Đã hủy') { %>
                                    <button onclick="deleteOrder('<%= orders[i]._id %>')" class="btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                                <% } %>
                             </div>
                         </div>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function searchOrders() {
            const searchText = document.getElementById('searchInput').value.toLowerCase();
            const rows = document.querySelectorAll('#ordersTableBody tr');
            let hasResults = false;
            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(searchText)) { row.style.display = ''; hasResults = true; }
                else { row.style.display = 'none'; }
            });
            if (!hasResults && searchText !== '') {
                const tbody = document.getElementById('ordersTableBody');
                if (document.getElementById('noResultRow')) return;
                const noResultRow = document.createElement('tr');
                noResultRow.id = 'noResultRow';
                noResultRow.innerHTML = '<td colspan="7" class="empty-row">Không tìm thấy đơn hàng nào</td>';
                tbody.appendChild(noResultRow);
            } else {
                const noResultRow = document.getElementById('noResultRow');
                if (noResultRow) noResultRow.remove();
            }
        }
        
        function filterOrders() {
            const status = document.getElementById('statusFilter').value;
            const date = document.getElementById('dateFilter').value;
            const rows = document.querySelectorAll('#ordersTableBody tr');
            let hasResults = false;
            rows.forEach(row => {
                if (row.id === 'noResultRow') return;
                const statusCell = row.cells[4]?.innerText || '';
                const dateCell = row.cells[5]?.innerText || '';
                let show = true;
                if (status !== 'all' && statusCell !== status) show = false;
                if (date && dateCell !== date) show = false;
                row.style.display = show ? '' : 'none';
                if (show) hasResults = true;
            });
            const noResultRow = document.getElementById('noResultRow');
            if (noResultRow) noResultRow.remove();
            if (!hasResults) {
                const tbody = document.getElementById('ordersTableBody');
                const newNoResultRow = document.createElement('tr');
                newNoResultRow.id = 'noResultRow';
                newNoResultRow.innerHTML = '<td colspan="7" class="empty-row">Không tìm thấy đơn hàng nào</td>';
                tbody.appendChild(newNoResultRow);
            }
        }
        
        function resetFilters() {
            document.getElementById('statusFilter').value = 'all';
            document.getElementById('dateFilter').value = '';
            document.getElementById('searchInput').value = '';
            const rows = document.querySelectorAll('#ordersTableBody tr');
            rows.forEach(row => { if (row.id !== 'noResultRow') row.style.display = ''; });
            const noResultRow = document.getElementById('noResultRow');
            if (noResultRow) noResultRow.remove();
        }
        
        function deleteOrder(orderId) {
            if (confirm('Bạn có chắc muốn xóa đơn hàng này?')) {
                fetch('/admin/orders/' + orderId, { method: 'DELETE' })
                .then(res => res.json())
                .then(data => { if(data.success) location.reload(); else alert(data.message); });
            }
        }
        
        document.getElementById('searchInput').addEventListener('keypress', function(e) { if (e.key === 'Enter') searchOrders(); });
    </script>
</body>
</html>